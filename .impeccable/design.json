      "css": ".ds-search-module{overflow:hidden;border:1px solid #e5e7eb;border-radius:12px;background:#fff;font-family:Geist,Arial,sans-serif}.ds-search-module-head{width:100%;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 16px;border:0;background:#fff;color:#374151;text-align:left;cursor:pointer}.ds-search-module-head:hover{background:#f9fafb}.ds-search-module-head:focus-visible{outline:2px solid #2563eb;outline-offset:-2px}.ds-search-module-head:active{background:#eff6ff}.ds-search-module-icon{width:36px;height:36px;display:grid;place-items:center;flex:0 0 auto;border-radius:8px;background:#dbeafe;color:#1d4ed8}.ds-search-module-icon svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}.ds-search-module-copy{min-width:0;display:grid;gap:2px;flex:1}.ds-search-module-copy strong{font-size:14px;line-height:20px;color:#1f2937}.ds-search-module-copy small{overflow:hidden;color:#6b7280;font-size:12px;line-height:16px;text-overflow:ellipsis;white-space:nowrap}.ds-search-module-meta{flex:0 0 auto;color:#1d4ed8;font-size:12px;font-weight:500}"
